# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/network_monitor?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=network-monitor
INFLUXDB_BUCKET=router_metrics

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRATION=7d

# Webhook Notifications
WEBHOOK_DEFAULT_URL=http://localhost:4000/api/v1/webhooks/test

# Encryption key for router credentials (32 bytes hex)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
